{
  "name": "github-typescript-utils",
  "version": "0.2.4",
  "description": "TypeScript utilities for GitHub Actions workflows - REST API, Octokit, context helpers, and common workflow functions",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "github-actions",
    "typescript",
    "github-api",
    "utilities",
    "rest-api",
    "octokit",
    "workflow",
    "context",
    "core",
    "github-script"
  ],
  "author": "tkstang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tkstang/github-typescript-utils.git"
  },
  "homepage": "https://github.com/tkstang/github-typescript-utils#readme",
  "bugs": {
    "url": "https://github.com/tkstang/github-typescript-utils/issues"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/ scripts/",
    "check:fix": "biome check --write src/ scripts/",
    "type-check": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "prepublishOnly": "pnpm run clean && pnpm run test:run && pnpm run build",
    "release:check": "node scripts/release/validate-tag.ts",
    "release:pack": "pnpm run clean && pnpm run build && node scripts/release/verify-package.ts",
    "release:prepare": "pnpm run release:check && pnpm run check && pnpm run type-check && pnpm run test:run && pnpm run release:pack"
  },
  "peerDependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@biomejs/biome": "2.2.4",
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.0.0"
  }
}
